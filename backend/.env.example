# Copie para backend/.env e preencha. O backend/.env não vai para o repositório.

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Validade do token (formato do jsonwebtoken: 12h, 30m, 1d...).
JWT_VALIDADE=12h

# 1 = cria as contas de demonstração (gestor@rotamestre.com e motorista@rotamestre.com, senha 123)
# e a rota RT-001. Não use em servidor público.
ROTAMESTRE_SEED_DEMO=1
